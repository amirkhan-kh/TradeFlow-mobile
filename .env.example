# ---- Mobile app (Expo) — copy to .env.local for `npx expo start` ----
# EXPO_PUBLIC_* values are baked into the app bundle: never put a secret here.
# Emulator: http://10.0.2.2:4000/api/v1 · real phone on the same Wi-Fi: http://<LAN-IP>:4000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
# Web dashboard for admin-only screens (staff, integrations, activity log).
EXPO_PUBLIC_WEB_URL=http://localhost:3001

# ---- Production API host (docker-compose.prod.yml). Copy to .env and fill every value; never commit .env. ----

# Public API domain, DNS A record → this server. Caddy issues the HTTPS certificate automatically.
API_DOMAIN=api.example.uz
# Exact web dashboard origin (the native app does not need CORS).
CORS_ORIGIN=https://tradeflow.example.uz

POSTGRES_USER=tradeflow
POSTGRES_DB=tradeflow
# openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -hex 32  (≥ 32 bytes; changing it logs everyone out)
JWT_SECRET=
# openssl rand -hex 32  (encrypts integration secrets; set once and back it up)
SECRET_KEY=

ADMIN_USERNAME=admin
# Strong password for the first admin (created on first boot only).
ADMIN_PASSWORD=
# true = first boot fills the database with demo data (demo users with password demo123).
SEED_DEMO=false

# Mobile version gate (GET /public/app-version). Raise *_LATEST after each store release, *_MIN only to block old builds.
MOBILE_ANDROID_MIN=1.0.0
MOBILE_ANDROID_LATEST=1.0.0
MOBILE_IOS_MIN=1.0.0
MOBILE_IOS_LATEST=1.0.0
