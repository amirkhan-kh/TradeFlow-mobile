{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:4002/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://trade-flow-one-psi.vercel.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "https://api.13-140-202-159.sslip.io/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://trade-flow-one-psi.vercel.app"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://api.13-140-202-159.sslip.io/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://trade-flow-one-psi.vercel.app"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
